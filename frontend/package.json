{
  "name": "kafka-explorer-frontend",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "audit:i18n": "node scripts/audit-i18n.mjs && node scripts/audit-used-keys.mjs",
    "audit:structure": "node scripts/audit-structure.mjs",
    "audit:dto": "node scripts/audit-dto.mjs",
    "audit:all": "npm run audit:i18n && npm run audit:dto && npm run audit:structure"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-alpha.97",
    "lucide-react": "^0.575.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  }
}
